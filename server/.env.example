# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/school_db?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT Secret Key (kisi bhi strong random string ka use karein)
JWT_SECRET=super_secret_jwt_key_mansarovar_2026

# Frontend Client URL (Vercel deployment URL)
# Example: https://mansarovar-school.vercel.app
CLIENT_URL=http://localhost:5173
